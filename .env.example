# Local setup overrides; defaults are supplied by setup.sh and Kubernetes YAML.
# REDIS_URL=redis://redis.truvag3-examples:6379
# TRUVAG3_REDIS_NAMESPACE=default
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.truvag3-examples:4318
# TRUVAG3_LOG_LEVEL=info
# TRUVAG3_LOG_FORMAT=json

# Optional existing Redis Cluster: use this form OR REDIS_URL, not both.
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=redis-node-0:6379,redis-node-1:6379,redis-node-2:6379
# TRUVAG3_REDIS_NAMESPACE=my-deployment
# TRUVAG3_REDIS_USERNAME=
# TRUVAG3_REDIS_PASSWORD=

# setup.sh generates and preserves a dedicated Kubernetes Secret containing
# ORDER_API_TOKEN. Give this write credential only to authorized API clients.

FROM golang:1.27.2-alpine AS builder
RUN apk add --no-cache ca-certificates git
WORKDIR /workspace
COPY retail-order-service/ ./retail-order-service/
WORKDIR /workspace/retail-order-service
ENV GOWORK=off CGO_ENABLED=0 GOMAXPROCS=2 GOFLAGS=-p=2
RUN go mod download
RUN go build -trimpath -ldflags='-s -w' -o /out/retail-order-service .

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -g 1001 -S app && adduser -u 1001 -S app -G app
COPY --from=builder /out/retail-order-service /app/retail-order-service
USER 1001:1001
WORKDIR /app
ENTRYPOINT ["/app/retail-order-service"]
